<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: back up Pause's settings, and move them to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="pause.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="pause.xml" />
    </device-transfer>
</data-extraction-rules>
